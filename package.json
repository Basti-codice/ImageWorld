{
  "name": "imageworld",
  "productName": "ImageWorld",
  "version": "1.0.0",
  "description": "Deine Fotos auf der Weltkarte – live synchronisiert mit deinen Ordnern.",
  "author": "ImageWorld",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --x64 --publish never && node scripts/verify-package.mjs release/win-unpacked",
    "icons": "node scripts/make-icons.mjs",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never && node scripts/verify-package.mjs release/win-unpacked",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "all-the-cities": "^3.1.0",
    "chokidar": "^6.0.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "d3-time": "^3.1.1",
    "d3-time-format": "^4.1.1",
    "exiftool-vendored": "^39.1.0",
    "ffmpeg-static": "^5.3.0",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.69.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
